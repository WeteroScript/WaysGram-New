+    private SharedPreferences forwardRetryPreferences() {
+        Activity activity = getParentActivity();
+        return activity == null ? null : activity.getSharedPreferences(
+                "waysgram_forward_retry_" + getCurrentAccount(), Context.MODE_PRIVATE
+        );
+    }
+
+    private String pendingForwardIdempotencyKey(String keyScope) {
+        String cached = forwardIdempotencyKeys.get(keyScope);
+        if (!TextUtils.isEmpty(cached)) return cached;
+        SharedPreferences preferences = forwardRetryPreferences();
+        long now = System.currentTimeMillis();
+        String key = null;
+        if (preferences != null) {
+            key = preferences.getString(keyScope, null);
+            long createdAt = preferences.getLong(keyScope + "_created", 0L);
+            if (TextUtils.isEmpty(key) || createdAt <= 0L || now - createdAt > 7L * 24 * 60 * 60 * 1000) {
+                preferences.edit().remove(keyScope).remove(keyScope + "_created").apply();
+                key = null;
+            }
+        }
+        if (TextUtils.isEmpty(key)) {
+            key = "wg-forward-" + UUID.randomUUID();
+            if (preferences != null) {
+                preferences.edit().putString(keyScope, key).putLong(keyScope + "_created", now).apply();
+            }
+        }
+        forwardIdempotencyKeys.put(keyScope, key);
+        return key;
+    }
+
+    private void clearPendingForwardIdempotencyKey(String keyScope) {
+        forwardIdempotencyKeys.remove(keyScope);
+        SharedPreferences preferences = forwardRetryPreferences();
+        if (preferences != null) {
+            preferences.edit().remove(keyScope).remove(keyScope + "_created").apply();
+        }
+    }
